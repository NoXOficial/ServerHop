-- Función lógica de Server Hop automático
local function serverHop()
    hopBtn.Text = "BUSCANDO..."
    hopBtn.BackgroundColor3 = Color3.fromRGB(180, 100, 30)
    
    local servers = {}
    local cursor = ""
    local gameId = game.PlaceId
    
    -- Consultar la API pública de servidores de Roblox
    while true do
        local url = "https://games.roblox.com/v1/games/" .. gameId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" + cursor
        end
        
        local success, response = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and response and response.data then
            for _, srv in ipairs(response.data) do
                -- Buscar servidores que tengan espacio libre y no estén llenos
                if type(srv) == "table" and srv.playing and srv.maxPlayers and srv.id ~= game.JobId then
                    if srv.playing < srv.maxPlayers then
                        table.insert(servers, srv.id)
                    end
                end
            end
            
            -- Si encontramos servidores disponibles, nos metemos a uno aleatorio de los vacíos/con poca gente
            if #servers > 0 then
                local targetServer = servers[math.random(1, #servers)]
                hopBtn.Text = "¡UNIENDO!"
                TeleportService:TeleportToPlaceInstance(gameId, targetServer, lPlayer)
                return
            end
            
            cursor = response.nextPageCursor
            if not cursor then break end
        else
            break
        end
        task.wait(0.2)
    end
    
    -- Si por alguna razón no encuentra
    hopBtn.Text = "¡NO SE ENCONTRÓ!"
    task.wait(2)
    hopBtn.Text = "BUSCAR SERVER VACÍO"
    hopBtn.BackgroundColor3 = Color3.fromRGB(40, 110, 200)
end

hopBtn.MouseButton1Click:Connect(serverHop)

-- Sistema de Arrastre del Menú
local dragging, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = mainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input) 
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
        dragging = false 
    end 
end)
